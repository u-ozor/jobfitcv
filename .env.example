# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# - Port Number -
# change if 8000 is taken by something else — also update BASE_URL in extension/config.js to match
PORT=8000 

# — Cache locations —
# Keeps model weights and browser binaries inside the project instead of
# scattering them across system-level directories (~/.cache, ~/Library/Caches).
HF_HOME=./.cache/huggingface
PLAYWRIGHT_BROWSERS_PATH=./.cache/playwright

# — API key —
# Required by default: cover letters, JD summarization at ingest, and wizard
# chunk creation all default to Anthropic. Also required if ENABLE_REWRITES
# in app/core/config.py (rewrites are off by default).
ANTHROPIC_API_KEY=

# — Ollama (optional) —
# Only needed if you set any *_PROVIDER below to "ollama", or use the chunk
# review "Assess Fit" feature (mistral:latest, fallback qwen2.5-coder:7b)
# Embeddings do NOT use Ollama — sentence-transformers runs self-contained.
# Base URL only — llm_client.py appends the endpoint path itself.
OLLAMA_BASE_URL=http://localhost:11434

# — OpenAI-compatible (optional) —
# Only needed if you set any *_PROVIDER below to "openai". Works with OpenAI,
# OpenRouter, Groq, Together, etc. — set OPENAI_BASE_URL for non-OpenAI hosts.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# — Per-feature provider/model overrides —
# Each feature defaults to Anthropic and its own model below. Every pair
# independent — switching one doesn't affect the others. Provider values:
# anthropic | openai | ollama

# Rewrite pipeline (app/rewrites/hooks.py) — inert unless ENABLE_REWRITES=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# Cover letter generation
CL_PROVIDER=anthropic
CL_MODEL=claude-sonnet-4-6

# JD summarization at ingest (produces the short structured Job.raw_text)
JD_SUMMARY_PROVIDER=anthropic
JD_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Wizard: plain-language -> structured chunk creation
WIZARD_PROVIDER=anthropic
WIZARD_MODEL=claude-haiku-4-5-20251001

# Chunk review: synthesize a bespoke summary from selected sections
SUMMARY_SYNTH_PROVIDER=anthropic
SUMMARY_SYNTH_MODEL=claude-haiku-4-5-20251001

# Experience auto-generate in setup_wizard.py (extracts experience.json from resume_chunks.json)
EXPERIENCE_PROVIDER=anthropic
EXPERIENCE_MODEL=claude-opus-4-7

# — Database —
# Path to the SQLite DB file. Default resolves to data/jobs.db relative to
# wherever the app is started from. Override if you want a different location
# or a named test DB (e.g. sqlite:///data/jobs_test.db).
DATABASE_URL=sqlite:///data/jobs.db

# — Timezone —
# Currently set as a constant in app/core/config.py (TIMEZONE = "America/Montreal").
# Move there if you need per-environment overrides.
# TIMEZONE=America/Montreal