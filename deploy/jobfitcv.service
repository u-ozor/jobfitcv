# deploy/jobfitcv.service
# systemd unit file — auto-starts the app on boot and restarts on crash.
# Place at /etc/systemd/system/jobfitcv.service
#
# Enable:  sudo systemctl enable jobfitcv
# Start:   sudo systemctl start jobfitcv
# Status:  sudo systemctl status jobfitcv
# Logs:    sudo journalctl -u jobfitcv -f

[Unit]
Description=jobfitcv API
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Update WorkingDirectory to match your clone path on EC2.
WorkingDirectory=/home/ubuntu/jobfitcv

ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

# Give the container time to pull/start on first boot.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
