{
  "manifest_version": 3,
  "name": "jobfitcv",
  "version": "1.0",
  "description": "Capture job postings and generate tailored resumes",

  "permissions": ["activeTab", "sidePanel", "scripting", "windows"],
  "host_permissions": ["http://localhost:*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_title": "jobfitcv",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },

  "side_panel": {
    "default_path": "panel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
